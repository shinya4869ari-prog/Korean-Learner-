{
  // 1. Workerの基本情報
  "name": "korean-learner",
  "main": "worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,

  // 2. 画面（index.html）の配信設定
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 3. カスタムドメインの設定 (Custom Domain)
  "routes": [
    {
      "pattern": "koreanews.seronworks.dev",
      "custom_domain": true
    }
  ],

  // 4. 辞書データベースの設定
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "korean-learner-dict",
      "database_id": "98ff31cb-043e-436d-ab4e-a1bf45cc0954",
      "migrations_dir": "migrations"
    }
  ]
}